# ── Build artifacts ───────────────────────────────────────────────────────────
/build/
*.exe

# DLLs — exclude all except the intentionally bundled wintun.dll
*.dll
!internal/vpn/assets/wintun.dll

# OpenVPN binaries are GPL — downloaded via scripts/download-openvpn.ps1, not committed
internal/vpn/assets/openvpn/*.exe
internal/vpn/assets/openvpn/*.dll

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/

# ── Wails ─────────────────────────────────────────────────────────────────────
/frontend/node_modules/
/frontend/dist/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.user

# ── Runtime temp files ────────────────────────────────────────────────────────
*.log
jamvpn-*.conf
jamvpn-*.ovpn
jamvpn-*.creds
